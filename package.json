{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram task agent on the Finland server, backed by headless DSH",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "main": "src/index.mjs",
  "scripts": {
    "start": "node src/index.mjs",
    "spec": "bash tools/spec-check.sh",
    "pretest": "bash tools/spec-check.sh",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "check": "bash tools/spec-check.sh && node --test --test-force-exit test/*.test.mjs"
  },
  "license": "MIT"
}
