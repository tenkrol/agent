#!/usr/bin/env bash
#
# Отчёт владельцу о завершённых задачах агента.
#
# Агент работает в песочнице и не может запускать внешние команды, а его код —
# тонкая обёртка над бинарником dsh, который сам пишет в журнал «dsh run finished».
# Сторож читает журнал раз в минуту и отправляет отчёт двумя путями:
#   • через бота-ассистента (agent-notify) — он ведёт к точке приёма бота;
#   • от бота самого агента (@Tenkrol_ag_bot) — владелец ждёт ответ именно от него.
# Отметка времени и flock не дают отчитаться дважды об одной задаче.
set -euo pipefail
exec 9>/var/lib/agent/run-watch.lock
flock -n 9 || exit 0

MARK=/var/lib/agent/run-watch.marker
[ -f "$MARK" ] || { date +%s > "$MARK"; echo "agent-run-watch: поставлена отметка, начну со следующей задачи"; exit 0; }
SINCE=$(cat "$MARK")
NOW=$(date +%s)
AGENT_ENV=${AGENT_ENV:-/etc/agent/agent.env}

send_from_agent_bot() {
  local text=$1 token owner
  [ -f "$AGENT_ENV" ] || return 0
  token=$(grep "^TELEGRAM_BOT_TOKEN=" "$AGENT_ENV" | cut -d= -f2- || true)
  owner=$(grep "^ALLOWED_USER_IDS=" "$AGENT_ENV" | cut -d= -f2- | cut -d, -f1 || true)
  [ -n "$token" ] && [ -n "$owner" ] || return 0
  curl -sS -m 15 -X POST "https://api.telegram.org/bot$token/sendMessage" \
    --data-urlencode "chat_id=$owner" --data-urlencode "text=$text" >/dev/null 2>&1 || true
}

journalctl -u dsh-agent --since "@$SINCE" --no-pager -o cat 2>/dev/null \
  | grep -F "dsh run finished" \
  | while IFS= read -r line; do
      ok=$(printf "%s" "$line" | grep -oE "\"ok\":(true|false)" | head -1 | cut -d: -f2)
      steps=$(printf "%s" "$line" | grep -oE "\"steps\":[0-9]+" | head -1 | cut -d: -f2)
      tokens=$(printf "%s" "$line" | grep -oE "\"totalTokens\":[0-9]+" | head -1 | cut -d: -f2)
      where=$([ "${ok:-true}" = "true" ] && echo "успешно" || echo "с ошибкой")
      text="Агент закончил задачу: $where. Шагов: ${steps:-?}, токенов: ${tokens:-?}."
      agent-notify --title "Отчёт агента" "$text" >/dev/null 2>&1 \
        || echo "agent-run-watch: отчёт в чат ассистента не ушёл" >&2
      send_from_agent_bot "$text"
    done

echo "$NOW" > "$MARK"
